# Backend settings (copy to backend/.env if you want to override defaults).
AUTO_SCANNER_DEVICE=auto
AUTO_SCANNER_CURRENCY_SYMBOL=$
AUTO_SCANNER_WARM_MODELS=true
AUTO_SCANNER_SAM2_MODEL_ID=facebook/sam2.1-hiera-tiny
AUTO_SCANNER_DINOV2_MODEL_ID=facebook/dinov2-small
AUTO_SCANNER_YOLO_SEG_MODEL_ID=yolo26n-seg.onnx
AUTO_SCANNER_YOLO_CONF=0.25
AUTO_SCANNER_YOLO_IOU=0.45
AUTO_SCANNER_YOLO_IMGSZ=640
AUTO_SCANNER_YOLO_ALLOWED_CLASSES=
AUTO_SCANNER_YOLO_REJECT_CLASSES=person
AUTO_SCANNER_YOLO_MIN_AREA_RATIO=0.005
AUTO_SCANNER_YOLO_MAX_AREA_RATIO=0.60
AUTO_SCANNER_YOLO_CENTER_WEIGHT=0.15
AUTO_SCANNER_MASK_MIN_BOX_IOU=0.25
AUTO_SCANNER_MASK_MIN_BOX_COVERAGE=0.50
AUTO_SCANNER_MASK_MAX_BORDER_FRACTION=0.10
AUTO_SCANNER_SAM_MIN_PRED_IOU=0.50

# HF_HOME, PYTORCH_ENABLE_MPS_FALLBACK and TOKENIZERS_PARALLELISM are set by
# scripts/run_backend.sh and app/bootstrap.py; do not override them here.
