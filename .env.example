# Backend settings (copy to backend/.env if you want to override defaults).
AUTO_SCANNER_DEVICE=auto
AUTO_SCANNER_CURRENCY_SYMBOL=$
AUTO_SCANNER_WARM_MODELS=true
AUTO_SCANNER_ENABLE_CLIP=false
AUTO_SCANNER_LOCALIZER=sam2_center
AUTO_SCANNER_CENTER_ROI_WIDTH=0.60
AUTO_SCANNER_CENTER_ROI_HEIGHT=0.70
AUTO_SCANNER_SAM2_CENTER_MIN_AREA_RATIO=0.005
AUTO_SCANNER_SAM2_CENTER_MAX_AREA_RATIO=0.60
AUTO_SCANNER_SAM2_CENTER_MIN_PRED_IOU=0.50
AUTO_SCANNER_SAM2_CENTER_MAX_BORDER_FRACTION=0.08
AUTO_SCANNER_SAM2_CENTER_FACE_IOU_REJECT=0.75
AUTO_SCANNER_SAM2_CENTER_FACE_COVERAGE_REJECT=0.70
AUTO_SCANNER_SAM2_CENTER_ROI_MARGIN_RATIO=0.03
# Only used when AUTO_SCANNER_LOCALIZER=sam3:
AUTO_SCANNER_SAM3_TEXT_PROMPT=product
AUTO_SCANNER_SAM3_PROMPT_BOX=true
AUTO_SCANNER_SAM3_MIN_SCORE=0.30
# Only used when AUTO_SCANNER_LOCALIZER=sam2:
AUTO_SCANNER_PROMPT_MODE=pinch_roi

# HF_HOME, PYTORCH_ENABLE_MPS_FALLBACK and TOKENIZERS_PARALLELISM are set by
# scripts/run_backend.sh and app/bootstrap.py; do not override them here.
